# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# URL publique du site (utilisee pour les redirections magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifications push — cle PUBLIQUE VAPID uniquement.
# La cle privee ne vit que dans les secrets de l'Edge Function Supabase,
# jamais dans le front ni dans ce depot.
# Generation d'une paire : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
